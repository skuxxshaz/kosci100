# From https://www.strava.com/settings/api — create an API application there.
# "Authorization Callback Domain" must match your deployed domain (no https://, no path),
# e.g. kosci100.vercel.app — use localhost for local dev.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Any long random string (32+ chars). Generate one with:
# openssl rand -base64 32
SESSION_SECRET=

# Set to your real deployed URL once live, e.g. https://kosci100.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional but needed for the Bingo Card tab to sync between you and Owen.
# Free tier at https://upstash.com — create a Redis database, copy these
# from its REST API section. Without these, bingo ticks only save locally
# per device instead of being shared.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
